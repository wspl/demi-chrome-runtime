<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  Chrome's fontconfig configuration in the Demi Chrome runtime, used through
  FONTCONFIG_FILE. It is self-contained: it does not include the Host's
  /etc/fonts/conf.d, so a bare Host and a full desktop resolve the runtime's
  fonts the same way, while fonts the system or the user installed are still
  found by name and for characters the runtime lacks.

  Generated by fonts/build.py from fonts/fonts.conf.in and fonts/fonts.json.
-->
<fontconfig>
  <!-- The runtime's fonts, relative to this file. -->
  <dir prefix="relative">../fonts</dir>
  <!-- The system's and the user's fonts; missing directories are skipped. -->
  <dir>/usr/share/fonts</dir>
  <dir>/usr/local/share/fonts</dir>
  <dir prefix="xdg">fonts</dir>
  <dir>~/.fonts</dir>

  <!-- The first writable one is used; none writable only costs a rescan. -->
  <cachedir prefix="xdg">fontconfig</cachedir>
  <cachedir>~/.fontconfig</cachedir>

  <!-- Rendering defaults (fontconfig's 10-hinting-slight, 10-yes-antialias). -->
  <match target="pattern">
    <edit name="antialias" mode="append"><bool>true</bool></edit>
    <edit name="hinting" mode="append"><bool>true</bool></edit>
    <edit name="hintstyle" mode="append"><const>hintslight</const></edit>
    <edit name="rgba" mode="append"><const>none</const></edit>
  </match>

  <!-- Metric-compatible aliases (fontconfig's 30-metric-aliases): pages laid
       out for Arial, Times and Courier keep their line breaks. -->
  <alias binding="same"><family>Arial</family><accept><family>Liberation Sans</family></accept></alias>
  <alias binding="same"><family>Helvetica</family><accept><family>Liberation Sans</family></accept></alias>
  <alias binding="same"><family>Times New Roman</family><accept><family>Liberation Serif</family></accept></alias>
  <alias binding="same"><family>Times</family><accept><family>Liberation Serif</family></accept></alias>
  <alias binding="same"><family>Courier New</family><accept><family>Liberation Mono</family></accept></alias>
  <alias binding="same"><family>Courier</family><accept><family>Liberation Mono</family></accept></alias>

  <!-- A request without a generic family falls back to sans-serif
       (fontconfig's 49-sansserif); Chrome's per-character fallback asks
       without any family. -->
  <match target="pattern">
    <test qual="all" name="family" compare="not_eq"><string>sans-serif</string></test>
    <test qual="all" name="family" compare="not_eq"><string>serif</string></test>
    <test qual="all" name="family" compare="not_eq"><string>monospace</string></test>
    <edit name="family" mode="append_last"><string>sans-serif</string></edit>
  </match>

  <!-- Generic families: Latin, then Chinese, Japanese and Korean, then every
       other script, the symbols and math, then emoji. Naming the runtime's
       fonts here ranks them before any Host font for the characters they
       cover. -->
  <alias>
    <family>sans-serif</family>
    <prefer>
      <family>Liberation Sans</family>
      <family>Noto Sans</family>
      <family>Noto Sans CJK SC</family>
@GENERIC@
      <family>Noto Color Emoji</family>
    </prefer>
  </alias>
  <alias>
    <family>serif</family>
    <prefer>
      <family>Liberation Serif</family>
      <family>Noto Serif</family>
      <family>Noto Sans CJK SC</family>
@GENERIC@
      <family>Noto Color Emoji</family>
    </prefer>
  </alias>
  <alias>
    <family>monospace</family>
    <prefer>
      <family>Liberation Mono</family>
      <family>Noto Sans Mono</family>
      <family>Noto Sans Mono CJK SC</family>
@GENERIC@
      <family>Noto Color Emoji</family>
    </prefer>
  </alias>
  <alias>
    <family>emoji</family>
    <prefer><family>Noto Color Emoji</family></prefer>
  </alias>

  <!-- A text's language picks its script's family first, before the generic
       family it falls back to. For Han characters, which Chinese, Japanese
       and Korean share, this gives each language its own shapes (as Debian's
       70-fonts-noto-cjk does). The runtime has no serif face for most
       scripts, so serif uses the sans face. -->
@LANGUAGES@
</fontconfig>
